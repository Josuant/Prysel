{
  "name": "prysel-extension",
  "displayName": "Prysel",
  "description": "El comportamiento del código Python, visible en un lienzo dentro de VS Code.",
  "version": "0.0.1",
  "private": true,
  "publisher": "prysel",
  "license": "MIT",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "activationEvents": [
    "onCommand:prysel.openCanvas",
    "onCommand:prysel.runAll",
    "onView:prysel.canvasView",
    "onCommand:prysel.trace",
    "onCommand:prysel.newLesson",
    "onCommand:prysel.explainFile",
    "onCommand:prysel.explainTopic",
    "onCommand:prysel.proposeSections",
    "onCommand:prysel.setAnthropicKey",
    "onCommand:prysel.clearAnthropicKey",
    "onCommand:prysel.showAiProvider"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "prysel.openCanvas",
        "title": "Abrir lienzo",
        "category": "Prysel"
      },
      {
        "command": "prysel.runAll",
        "title": "Ejecutar el archivo",
        "category": "Prysel"
      },
      {
        "command": "prysel.trace",
        "title": "Reproducir el programa paso a paso",
        "category": "Prysel"
      },
      {
        "command": "prysel.newLesson",
        "title": "Crear o abrir la lección de este archivo",
        "category": "Prysel"
      },
      {
        "command": "prysel.showAiProvider",
        "title": "Qué proveedor de IA se usaría",
        "category": "Prysel"
      },
      {
        "command": "prysel.explainFile",
        "title": "Explicar este archivo con IA (genera su lección)",
        "category": "Prysel"
      },
      {
        "command": "prysel.explainTopic",
        "title": "Explicar un tema con IA (genera un programa nuevo y su lección)",
        "category": "Prysel"
      },
      {
        "command": "prysel.proposeSections",
        "title": "Proponer etapas con IA (comentarios de sección que parten los bloques largos)",
        "category": "Prysel"
      },
      {
        "command": "prysel.interrupt",
        "title": "Interrumpir la ejecución",
        "category": "Prysel"
      },
      {
        "command": "prysel.restart",
        "title": "Reiniciar el motor",
        "category": "Prysel"
      },
      {
        "command": "prysel.setAnthropicKey",
        "title": "Configurar la clave de Anthropic",
        "category": "Prysel"
      },
      {
        "command": "prysel.clearAnthropicKey",
        "title": "Borrar la clave de Anthropic",
        "category": "Prysel"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prysel",
          "title": "Prysel",
          "icon": "resources/prysel.svg"
        }
      ]
    },
    "views": {
      "prysel": [
        {
          "type": "webview",
          "id": "prysel.canvasView",
          "name": "Lienzo"
        }
      ]
    },
    "configuration": {
      "title": "Prysel",
      "properties": {
        "prysel.python": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Intérprete de Python con el que se ejecuta el código desde el lienzo. Vacío: el entorno elegido en la extensión de Python (o `python` del PATH)."
        },
        "prysel.aiProvider": {
          "type": "string",
          "enum": [
            "auto",
            "vscode",
            "anthropic"
          ],
          "enumDescriptions": [
            "El de vscode.lm si hay uno instalado (p. ej. Copilot); si no, el de Anthropic si hay clave.",
            "Solo el modelo de chat que ya tengas instalado en VS Code (sin clave).",
            "Solo la API de Anthropic, con la clave guardada con «Prysel: Configurar la clave de Anthropic»."
          ],
          "default": "auto",
          "markdownDescription": "Con qué IA se genera la lección de «Explicar este archivo»."
        },
        "prysel.anthropicModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Modelo de la API de Anthropic a usar. Vacío: el que trae la extensión por defecto (cámbialo si tu cuenta no tiene acceso a ese)."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "package": "node scripts/package.mjs",
    "e2e": "node e2e/run.mjs"
  },
  "devDependencies": {
    "@prysel/python": "workspace:*",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "@prysel/design-tokens": "workspace:*",
    "@prysel/morphology": "workspace:*",
    "@prysel/spatial": "workspace:*",
    "@prysel/ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/vscode": "^1.92.0",
    "@vitejs/plugin-react": "catalog:",
    "esbuild": "^0.25.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "En un espacio de trabajo sin confianza el lienzo se puede ver y editar, pero no ejecutar código."
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prysel/prysel.git"
  },
  "keywords": [
    "python",
    "visual",
    "diagram",
    "notebook",
    "data science"
  ]
}
