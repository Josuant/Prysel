{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "prysel: build",
      "type": "shell",
      "command": "node",
      "args": ["scripts/build.mjs"],
      "options": {
        "cwd": "${workspaceFolder}/packages/extension"
      },
      "problemMatcher": []
    },
    {
      "label": "prysel: watch",
      "type": "shell",
      "command": "node",
      "args": ["scripts/build.mjs", "--watch"],
      "options": {
        "cwd": "${workspaceFolder}/packages/extension"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
